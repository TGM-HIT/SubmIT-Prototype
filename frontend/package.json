{
  "name": "flightlog-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "node scripts/preview.mjs",
    "preview:help": "node scripts/preview.mjs --help",
    "preview:test": "node --test scripts/preview.smoke.mjs",
    "api:types": "openapi-typescript ../contracts/openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@vitejs/plugin-vue": "^6.0.1",
    "@types/node": "^24.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.5.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
