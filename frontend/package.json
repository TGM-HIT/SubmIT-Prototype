{
  "name": "submit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check:deprecated": "node scripts/check-deprecated-apis.mjs",
    "typecheck": "npm run check:deprecated && vue-tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "node scripts/preview.mjs",
    "preview:help": "node scripts/preview.mjs --help",
    "preview:test": "node --test scripts/preview.smoke.mjs scripts/keyboard.smoke.mjs scripts/documentation/documentation.smoke.mjs scripts/deprecated-apis.smoke.mjs",
    "test:keyboard": "node scripts/keyboard.mjs",
    "api:types": "openapi-typescript ../contracts/openapi.yaml --default-non-nullable false -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-i18n": "11.1.10",
    "vue-router": "^4.6.3"
  },
  "overrides": {
    "js-beautify": {
      "glob": "13.0.6"
    }
  },
  "devDependencies": {
    "@intlify/devtools-types": "11.1.10",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "~2.4.11",
    "jsdom": "^28.0.0",
    "openapi-typescript": "^7.5.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.1"
  }
}
