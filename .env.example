# Copy to .env (git-ignored) and adjust.

# Initial administrator account (created only when both are set).
DADB_BOOTSTRAPADMIN_USERNAME=admin
DADB_BOOTSTRAPADMIN_PASSWORD=change-me-to-a-strong-password

# Optional local testing-profile fixtures; only the literal value true enables minimal mode.
# The Makefile includes and exports .env, but `make run-testing` and
# `make run-backend-testing` explicitly use full fixtures; use `make run-testing-minimal`
# to opt in without editing .env.
# DADB_TESTING_MINIMAL_FIXTURES=true

# JWT signing secret, at least 32 bytes.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# Host port for the web UI.
DADB_PORT=8081

# Backend URL the Vite dev server proxies /api to.
VITE_BACKEND_URL=http://localhost:8080